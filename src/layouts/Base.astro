---
import '../styles/global.css';
import { UI, LANGS, LANG_LABEL, girlNames, TYPE } from '../data/i18n.js';
import CoastBackdrop from '../components/CoastBackdrop.astro';
import MessageBoard from '../components/MessageBoard.astro';

interface Props {
  title?: string;
  desc?: string;
}

const { title = 'DOAXVV 攻略站', desc = '死或生 沙滩排球：维纳斯假期 中文攻略百科' } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL || '/';
const buildDate = new Date().toISOString().slice(0, 10);
const ogImage = new URL('img/bg/bg1.jpg', Astro.site).href;

const nav = [
  { key: 'admin.home', href: '/', match: (p: string) => p === '/' },
  { key: 'admin.girls', href: '/girls', match: (p: string) => p.startsWith('/girls') },
  { key: 'admin.swimsuits', href: '/swimsuits', match: (p: string) => p.startsWith('/swimsuits') },
  { key: 'admin.skills', href: '/skills', match: (p: string) => p.startsWith('/skills') },
  { key: 'admin.tools', href: '/tools', match: (p: string) => p.startsWith('/tools') },
  { key: 'admin.guide', href: '/guide', match: (p: string) => p.startsWith('/guide') },
  { key: 'admin.community', href: '/community', match: (p: string) => p.startsWith('/community') },
  { key: 'admin.reference', href: '/reference', match: (p: string) => p === '/reference' },
  { key: 'admin.help', href: '/help', match: (p: string) => p.startsWith('/help') }
];
const I18N = { ui: UI, girls: girlNames, langs: LANGS, labels: LANG_LABEL, type: TYPE };
---

<!doctype html>
<html lang="zh-CN" data-base={base}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>  

    <script is:inline>
      const q = new URLSearchParams(location.search).get('lang');
      let L = q || localStorage.getItem('lang') || 'zh';
      if (!['zh','en','ja'].includes(L)) L = 'zh';
      localStorage.setItem('lang', L);
      window.__LANG = L;
      document.documentElement.lang = L; if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
  </head>
  <body class="min-h-screen bg-mist text-ink">
  {!path.startsWith('/swimsuits') && <CoastBackdrop />}
    <aside id="sidebar" class="fixed left-0 top-0 z-50 flex h-full w-64 -translate-x-full flex-col border-r border-line bg-[#f6fafd]/95 shadow-xl backdrop-blur-xl transition-transform duration-300 md:translate-x-0">
      <a href={base} class="flex items-center gap-3 px-5 py-4 no-underline">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-pool-400 via-pool-500 to-pool-700 text-white shadow-md ring-1 ring-white/20">🏖</span>
        <span class="leading-tight">
          <span class="block text-base font-extrabold text-ink" data-i18n="brand">DOAXVV 攻略站</span>
          <span class="block text-[11px] text-ink-soft" data-i18n="brand.sub">维纳斯群岛度假攻略</span>
        </span>
      </a>

      <div class="px-4 py-2">
        <input id="h-search" type="search" placeholder="搜索…" data-i18n-ph="search.placeholder" class="w-full rounded-full border border-line bg-pool-50/50 px-4 py-2 text-sm outline-none focus:border-pool-400" />
      </div>

      <nav class="mt-1 flex-1 space-y-1 overflow-y-auto px-3 pb-2">
        {nav.map((n) => (
          <a
            href={base + n.href.replace(/^\//, '')}
            data-i18n={n.key}
            class:list={[
              'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold no-underline transition-colors',
              n.match(path) ? 'bg-gradient-to-r from-pool-500 to-pool-600 text-white shadow-sm' : 'text-ink-soft hover:bg-pool-50 hover:text-pool-700'
            ]}
          >
            {UI.zh[n.key]}
          </a>
        ))}
      </nav>

      <div class="border-t border-line px-4 py-3">
        <div class="mb-2 flex items-center rounded-full border border-line bg-pool-50/50 p-0.5">
          {LANGS.map((l) => (
            <button data-setlang={l} class="flex-1 rounded-full px-2.5 py-1 text-xs font-semibold text-ink-soft hover:text-pool-700">{LANG_LABEL[l]}</button>
          ))}
        </div>
        <div class="flex items-center justify-between">
          <button id="themeBtn" class="grid h-8 w-8 place-items-center rounded-full border border-line bg-pool-50/50 text-sm" title="主题">🌙</button>
        </div>
        <p class="mt-3 text-[11px] text-ink-soft">数据快照 {buildDate} · 本地版</p>
      </div>
    </aside>

    <div id="menu-overlay" class="fixed inset-0 z-40 hidden bg-black/40 md:hidden"></div>
    <header class="sticky top-0 z-40 flex h-14 items-center gap-3 border-b border-line bg-white/85 px-4 backdrop-blur md:hidden">
      <button id="menu-btn" class="grid h-10 w-10 place-items-center rounded-xl border border-line text-ink" aria-label="打开菜单">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
      <span class="text-base font-extrabold text-ink" data-i18n="brand">DOAXVV 攻略站</span>
    </header>

    <div class="md:ml-64">
      <main>
        <slot />
      </main>

      <footer class="mt-16 border-t border-line bg-white">
        <div class="container-wiki py-8 text-sm text-ink-soft">
          <p class="font-semibold text-ink">DOAXVV 攻略站</p>
          <p class="mt-2" data-i18n="footer.note">内容整理自官方帮助文档与社区公开资料；图片与攻略版权归原作者。</p>
          <p class="mt-2 text-xs">数据快照：{buildDate}（doax.cc）</p>
                    <p class="mt-2 text-xs">帮助中心：<a href={base + 'help'} class="font-semibold text-pool-600">/help</a></p>
          <p class="mt-2 text-xs">官方：<a href="https://game.doaxvv.com" target="_blank" rel="noopener" class="font-semibold text-pool-600">game.doaxvv.com</a>　·　数据源：<a href="https://doax.cc" target="_blank" rel="noopener" class="font-semibold text-pool-600">doax.cc</a></p>
        </div>
      </footer>
    </div>

    <MessageBoard />

    <div id="i18n-data" hidden>{JSON.stringify(I18N)}</div>
    <script>
      const IDATA = JSON.parse(document.getElementById('i18n-data').textContent);
      let LANG = window.__LANG || 'zh';
      const tkey = (k) => (IDATA.ui[LANG] && IDATA.ui[LANG][k]) || IDATA.ui.zh[k] || k;
      function xtrans() {
        const tl = IDATA.type[LANG] || {};
        document.querySelectorAll('[data-i18n]').forEach((el) => { el.textContent = tkey(el.getAttribute('data-i18n')); });
        document.querySelectorAll('[data-i18n-ph]').forEach((el) => { el.setAttribute('placeholder', tkey(el.getAttribute('data-i18n-ph'))); });
        document.querySelectorAll('[data-type-label]').forEach((el) => { el.textContent = tl[el.getAttribute('data-type-label')] || el.getAttribute('data-type-label'); });
        document.querySelectorAll('[data-name-id]').forEach((el) => { const gn = IDATA.girls[el.getAttribute('data-name-id')]; if (gn && gn[LANG]) el.textContent = gn[LANG]; });
      }
      function applyLang(l) { LANG = l; window.__LANG = l; localStorage.setItem('lang', l); document.documentElement.lang = l; xtrans(); window.dispatchEvent(new CustomEvent('langchange', { detail: l })); }
      xtrans();
      document.querySelectorAll('[data-setlang]').forEach((b) => { b.addEventListener('click', () => applyLang(b.getAttribute('data-setlang'))); });
      const toggleTheme = () => { const d = document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', d ? 'dark' : 'light'); const icons = [document.getElementById('themeBtn'), document.getElementById('themeBtnM')]; icons.forEach((i) => { if (i) i.textContent = d ? '☀️' : '🌙'; }); };
      [document.getElementById('themeBtn'), document.getElementById('themeBtnM')].forEach((b) => { if (b) b.addEventListener('click', toggleTheme); });

      // 左侧栏抽屉
      const sidebar = document.getElementById('sidebar'), overlay = document.getElementById('menu-overlay');
      const openSidebar = () => { sidebar.classList.remove('-translate-x-full'); overlay.classList.remove('hidden'); };
      const closeSidebar = () => { sidebar.classList.add('-translate-x-full'); overlay.classList.add('hidden'); };
      document.getElementById('menu-btn')?.addEventListener('click', openSidebar);
      overlay?.addEventListener('click', closeSidebar);
      // 侧栏搜索：回车跳全站搜索
      document.getElementById('h-search')?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const v = e.target.value.trim(); location.href = (document.documentElement.getAttribute('data-base') || '/') + 'search?q=' + encodeURIComponent(v); } });
    </script>
  
  </body>
</html>