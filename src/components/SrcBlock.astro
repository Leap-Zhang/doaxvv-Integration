---
interface Props {
  title: string;
  url: string;
  author?: string;
  flag?: string;
  flagClass?: string;
  bullets?: string[];
  body?: string;
  note?: string;
  img?: string;
  imgAlt?: string;
}
const { title, url, author, flag, flagClass = 'badge-blush', bullets, body, note, img, imgAlt } = Astro.props;
---

<div class="rounded-2xl border border-line bg-white p-6 shadow-[0_10px_30px_rgba(18,58,99,0.06)]">
  <div class="flex flex-wrap items-center gap-2">
    <a href={url} target="_blank" rel="noopener" class="text-base font-extrabold text-pool-700 hover:underline">{title}</a>
    {flag && <span class={`badge ${flagClass}`}>{flag}</span>}
  </div>
  {img && <img src={img} alt={imgAlt || title} loading="lazy" class="mt-3 h-44 w-full rounded-lg object-cover"/>}
  <p class="mt-2 text-xs text-ink-soft">
    来源：{author && <>{author}</>}<a href={url} target="_blank" rel="noopener" class="font-semibold text-pool-600">&nbsp;查看原文 ↗</a>
  </p>
  {body
    ? <p class="mt-3 leading-relaxed text-ink-soft" set:html={body} />
    : bullets && (
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-ink-soft">
          {bullets.map((b) => <li set:html={b} />)}
        </ul>
      )}
  {note && <p class="mt-3 border-t border-dashed border-line pt-2 text-xs text-ink-soft">{note}</p>}
</div>
