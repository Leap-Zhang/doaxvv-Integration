---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  desc?: string;
}
const { title, desc } = Astro.props;
---

<Base title={`${title} · 系统指南 · DOAXVV 攻略站`} desc={desc}>
  <div class="container-wiki py-10">
    <nav class="text-sm text-ink-soft">
      <a href="/" class="no-underline">首页</a> / <a href="/guide" class="no-underline">系统指南</a> / <span class="text-ink">{title}</span>
    </nav>
    <p class="mt-3 text-sm font-semibold text-pool-600">系统指南</p>
    <h1 class="mt-1 text-3xl font-black">{title}</h1>
    {desc && <p class="mt-2 max-w-3xl text-ink-soft">{desc}</p>}
    <p class="mt-3 rounded-xl bg-pool-50 p-3 text-sm text-pool-800" data-i18n="ed.note"></p>
    <div class="mt-8">
      <slot />
    </div>
  </div>
</Base>
