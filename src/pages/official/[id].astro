---
import Base from '../../layouts/Base.astro';
import official from '../../data/official-news.json';
const root = import.meta.env.BASE_URL || '/';
export function getStaticPaths() {
  const sl = (u) => (u || '').replace(/^.*\//, '').split('?')[0].replace(/\.html$/, '');
  const seen = {}; const out = [];
  official.history.forEach((n, idx) => { let id = sl(n.url); if (!id) id = 'item-' + idx; if (seen[id]) id = id + '-' + idx; seen[id] = true; out.push({ params: { id }, props: { idx } }); });
  return out;
}
const { idx } = Astro.props;
const n = (official.history || [])[idx];
const esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const catLabel = (c) => ({ gacha: '扭蛋', swimsuit: '泳装', event: '活动', version: '版本', maintenance: '维护', other: '其他' }[c] || c);
const catChip = (c) => ({ gacha: 'badge-blush', swimsuit: 'badge-pool', event: 'badge-sand', version: 'badge-pool', maintenance: 'badge-blush', other: 'badge-sand' }[c] || 'badge-sand');
function renderBlocks(bl, title) {
  if (!bl || !bl.length) return '';
  return bl.map((b) => {
    if (b.type === 'img') return `<figure class="overflow-hidden rounded-xl border border-line"><a href="${root + esc(b.src)}" target="_blank" rel="noopener"><img src="${root + esc(b.src)}" alt="${esc(b.alt || title)}" loading="lazy" class="w-full object-cover" /></a></figure>`;
    if (b.type === 'table') return `<div class="overflow-x-auto rounded-xl border border-line"><table class="tbl min-w-[480px] w-full"><tbody>${b.rows.map((r) => `<tr>${r.map((c) => `<td>${esc(c)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
    if (b.type === 'heading') return `<h3 class="mt-6 text-lg font-extrabold text-pool-700">${esc(b.text)}</h3>`;
    return `<p class="text-[15px] leading-8 text-ink/90">${esc(b.text)}</p>`;
  }).join('');
}
---

<Base title={`${n.title} · 官方公告 · DOAXVV 攻略站`} desc={n.title}>
  <div class="container-wiki py-10">
    <nav class="text-sm text-ink-soft">
      <a href={`${root}official/`} class="no-underline">官方公告</a> / <span class="text-ink">详情</span>
    </nav>

    <div class="mt-5 overflow-hidden rounded-3xl border border-line bg-white">
      <div class="bg-gradient-to-r from-pool-700 to-pool-500 p-7 text-white">
        <div class="flex flex-wrap items-center gap-2">
          <span class:list={['badge', catChip(n.category)]}>{catLabel(n.category)}</span>
          <span class="text-xs tabular-nums text-pool-100">{n.date}</span>
          <span class="text-xs text-pool-200">{n.kind === 'update' ? '版本更新' : '官方信息'}</span>
        </div>
        <h1 class="mt-3 text-2xl font-black leading-snug sm:text-3xl">{n.title}</h1>
      </div>

      <div class="grid gap-6 p-6 md:grid-cols-[1fr_260px]">
        <article class="space-y-4" set:html={renderBlocks(n.blocks, n.title)} />
        <aside>
          <div class="rounded-xl border border-line bg-pool-50/60 p-4 text-sm">
            <p class="font-semibold text-pool-700">来源</p>
            <p class="mt-1 text-ink-soft">DOAXVV 官网（光荣特库摩）</p>
            <a href={n.url} target="_blank" rel="noopener" class="mt-2 inline-block text-xs font-semibold text-pool-600 no-underline hover:underline">官网原文 ↗</a>
          </div>
          <a href={`${root}official/`} class="mt-3 inline-block text-xs font-semibold text-pool-600 no-underline hover:underline">← 返回公告列表</a>
        </aside>
      </div>
    </div>
  </div>
</Base>