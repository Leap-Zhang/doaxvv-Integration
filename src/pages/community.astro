---

import Base from '../layouts/Base.astro';
import SrcBlock from '../components/SrcBlock.astro';
const root = import.meta.env.BASE_URL || '/';


const roadmap = [
  { n:'1', title:'理解战力构成', desc:'衣服最重，其次饰品/技能/潜力/应援板叠加。', posts:[['简单介绍衣服系统','https://tieba.baidu.com/p/6519750123'],['纯萌新攻略','https://tieba.baidu.com/p/8119453382']], mod:'swimsuits', modLabel:'泳装图鉴' },
  { n:'2', title:'选主C与定位', desc:'力量/技巧主力各一；先看量化排行与常驻潜力。', posts:[['各角色刷分能力排行','http://jump2.bdimg.com/p/6457976789'],['steam 全角色 SSR 觉醒技能推荐','https://tieba.baidu.com/p/6387901332']], mod:'girls', modLabel:'女孩图鉴' },
  { n:'3', title:'配装与属性', desc:'3 体力服 + 1 刷分服；A/P/F 三技能；涂油+声援板成型。', posts:[['活动赛通关与大跳指南','https://tieba.baidu.com/p/8969809061'],['入坑日服记录贴三','https://www.tieba.com/p/8244540500']], mod:'tools/panel', modLabel:'面板估算器' },
  { n:'4', title:'爬山·满破·PP', desc:'满破除“皮肤→首饰”；减体量力爬、PP 配比毕业。', posts:[['第一次爬山该爬什么','https://jump2.bdimg.com/p/6514099383'],['寄服最大化收益爬山方法','http://ent.tieba.com/p/8846280244']], mod:'reference', modLabel:'资料库·潜力PP' },
  { n:'5', title:'过关·竞技场', desc:'主手正属性攻击得分；沙包玩法与攻/防副分工。', posts:[['学习贴：前排学习 JJC 冠军配置','http://jump2.bdimg.com/p/8770759954'],['为什么我的攻副这么水','https://tieba.baidu.com/p/8864419517']], mod:'guide', modLabel:'系统指南' }
];
const faq = [
  ['为什么说“衣服”最重要？','女孩强度≈裸体+衣服+首饰+技能+潜力+应援板，衣服是大头加成。'],
  ['开荒先练谁？','力量 / 技巧主力各一个；用工具人开荒攒资源。'],
  ['刷分服怎么选？','约 5000 正属性的 A/P/F 三技能衣服；力量角色可优先海咲（生日装极品、PP 好凑）。'],
  ['卡 SS+ 了怎么办？','多在等级/首饰/涂油；先拿攻坚服过渡，借大佬两球凹分，别硬抽流行。'],
  ['爬山先爬什么？','缺潜力优先爬力量女孩；满破除衣服→首饰，PP 配比毕业。'],
  ['攻副怎么选？','海咲不适合攻副；换七海+凪咲打双攻更稳；防副可用玛小丽+绫音。'],
  ['竞技场怎么得分？','只有主手正属性攻击得分；沙包方最大化主手倒转技能收益。']
];
const core = [
  { t:'纯萌新攻略', u:'https://tieba.baidu.com/p/8119453382', a:'贴吧 · 江浦', why:'从战力构成理解“为什么衣服最重要”。' },
  { t:'简单介绍衣服系统', u:'https://tieba.baidu.com/p/6519750123', a:'贴吧', why:'女孩强度构成的底层公式。' },
  { t:'第一次爬山该爬什么', u:'https://jump2.bdimg.com/p/6514099383', a:'贴吧', why:'爬塔满破与 PP 首饰的核心机制。' },
  { t:'活动赛通关与大跳指南', u:'https://tieba.baidu.com/p/8969809061', a:'贴吧', why:'稳定通关活动赛与大跳的基准线。' }
];

const sections = [
  {
    title: '新手开荒',
    blocks: [
      {
        title: '纯萌新攻略',
        img: root + 'img/hero_day.webp', imgAlt: '实机截图（白昼泳池）', url: 'https://tieba.baidu.com/p/8119453382', author: '百度贴吧 · 江浦', flag: '精华',
        bullets: [
          '女孩战力来源：等级、泳装与饰品、涂油、应援板，其中<b>衣服最为重要</b>。',
          '一个培养毕业的主手女孩至少准备：3 件后缀不同的体力服 + 1 件不错的刷分服（要练的女孩最好已持有其中 2~3 件）。',
          '好的刷分服通常是约 5000 正属性的 A / P / F 三技能衣服。',
          '开局可按力量 / 技巧方向各选一名能做主的女孩作主力。'
        ],
        note: '从战力构成入手，给出角色养成的“底层配置”思路。'
      },
      {
        title: '简单介绍衣服系统',
        img: root + 'img/swim_platinum.webp', imgAlt: '白金泳装实机截图', url: 'https://tieba.baidu.com/p/6519750123', author: '百度贴吧',
        body: '女孩强度 ≈ 女孩裸体强度 + 衣服强度 + 首饰强度 + 软绵绵技能 + 潜力系统 + 应援板系统（应援板仅为 DMM 服实装）。对萌新来说最直接、最主要的来源是<b>衣服</b>——角色本体基础属性可能只有几百，衣服带来的是大头加成。',
        note: '适合新玩家理解“为什么衣服这么重要”。'
      },
      {
        title: '新手入坑 · 常见玩法 / 注意事项 / 规划汇总', url: 'https://tieba.baidu.com/p/6703793457', author: '百度贴吧',
        bullets: [
          '前期重点培养一个力量角色 + 一个技巧角色。',
          '抽到当期流行就穿上打活动；力量角色可优先考虑<b>海咲</b>（生日装极品、PP 好凑）。',
          '其余角色可等后续强卡（避免错过饰品与<b>周年复刻</b>）；刷分用双 SR 即可拿到 S 级。',
          '平时囤钻石、觉醒石、衣服，等周年/爬山活动再投入。'
        ],
        note: '偏开荒规划与资源取舍。'
      }
    ]
  },
  {
    title: '角色定位与培养',
    blocks: [
      {
        title: '心血来潮抠细节', url: 'http://jump2.bdimg.com/p/9012574359', author: '百度贴吧',
        bullets: [
          '<b>二阶：</b>拥有 1~2 件真正意义上的刷分装。',
          '<b>三阶：</b>确定主力，开始向 SSS 等级推进。',
          '<b>四阶：</b>有两名女孩可分别打通力量 / 技巧的 SSS 并拿到 S 评价。',
          '用<b>工具人</b>开荒，能获得更多资源来培养你的真正主力。'
        ],
        note: '把养成目标拆成可执行的阶段。'
      },
      {
        title: '各角色刷分能力排行（数据贴）', url: 'http://jump2.bdimg.com/p/6457976789', author: '百度贴吧',
        body: '排名基于角色穿指定刷分装、进行完全养成，8 回合大跳可打出的平均分；角色等级 80、星等级 SSS+、泳装满强化满觉醒。仅列举带<b>杀球 / 假动作 F 技能</b>的刷分装，并加入少量辅助装与无 F 装。',
        note: '选培养对象时可参考的量化排名。'
      },
      {
        title: 'DOAXVV 打分队（攻略向）',
        img: root + 'img/promo.webp', imgAlt: 'Misty Lily 泳装宣传图', url: 'https://www.bilibili.com/opus/566244485395289268', author: 'Bilibili 专栏',
        bullets: [
          '<b>力量偏向：</b>环（Tamaki）。',
          '<b>技巧偏向：</b>玛莉萝丝、海莲娜、莫妮卡、绫音、丽凤、霞。',
          '潜力技能中有提升魅力的技能，可通过<b>爬山</b>进一步提升（爬山优先提升 SSR / SR 满破所得技能）。'
        ],
        note: '角色定位的“属性偏向”速查。'
      },
      {
        title: 'steam 全角色 SSR 觉醒技能推荐', url: 'https://tieba.baidu.com/p/6387901332', author: '百度贴吧',
        body: '以海咲为例：<b>满级属性 P2528 / T2388 / S3029</b>（力量角色）；常驻与第一次贝壳泳装满破后得到“隐藏的力量 3 / 4”约 <b>12PP</b> 技能。目前海咲缺少强力刷分服，<b>JK 服 / 圣诞服</b>可作副手辅助得分。',
        note: '给“练谁、怎么满破”一个参考。'
      },
      {
        title: '(水) 关于 10 个常驻女孩的小知识', url: 'https://jump2.bdimg.com/p/7841056449', author: '百度贴吧',
        bullets: [
          '<b>玛莉萝丝：</b>有常驻 SR 体力 + 升级送 8PP 体力，练成难度最低。',
          '<b>海莲娜：</b>有常驻 SR 体力。',
          '<b>绫音、霞：</b>有常驻 SR 技巧接球 12PP，合计约 61% 接球+技巧。',
          '<b>穗香：</b>接球需补大技巧 12 / 13PP。'
        ],
        note: '常驻角色的潜力 / PP 构成拆解。'
      }
    ]
  },
  {
    title: '爬山・爬塔与满破',
    blocks: [
      {
        title: '【萌新向/手把手】第一次爬山该爬什么',
        img: root + 'img/hero_night.webp', imgAlt: '实机截图（夜晚泳池）', url: 'https://jump2.bdimg.com/p/6514099383', author: '百度贴吧',
        body: '<b>满破（最大化利用技能）：</b>用额外 4 件相同的衣服或 4 个觉醒石（可混搭，位置在“套装—技能觉醒”），把某件 SR / SSR 的 P 技能从衣服上取下来，放进头 / 脸 / 手三个首饰后，穿任意衣服都能发动——这是提升女孩战力的最重要途径之一。',
        note: '爬山活动的核心机制：满破与 PP 首饰。'
      },
      {
        title: '本期爬山', url: 'http://jump2.bdimg.com/p/8246838113', author: '百度贴吧',
        body: '没有明确规划可爬的，可以把<b>原钻</b>爬了。新玩家女孩都缺潜力，<b>优先爬力量女孩</b>；活动币充足时可把<b>所有女孩都爬</b>（前期 5PP 总是缺的不够用）。',
        note: '爬山资源优先级。'
      },
      {
        title: '寄服最大化收益爬山方法', url: 'http://ent.tieba.com/p/8846280244', author: '百度贴吧',
        body: '白嫖最大化收益：假如已爬 <b>3 个 13PP 减体</b>，就再爬 <b>5PP + 2PP + 4PP 减体</b>，正好塞进 <b>19PP 首饰</b>，不会浪费任何一次毕业爬山次数；剩下一个空位塞原钻或没爬山的 5PP。',
        note: '毕业爬山的 PP 配比参考。'
      },
      {
        title: '萌新打到 SS+ 死活打不动了', url: 'https://www.tieba.com/p/8704375601', author: '百度贴吧',
        body: '打到 <b>SS+</b> 卡关时，女孩等级、首饰等级、涂油这“三大项”一时很难提升。建议加入大佬借两球凹分，或先拿<b>攻坚服</b>过渡；不到万不得已不硬抽流行。爬塔阶段不必急着强化 SSR，优先<b>囤钻石、觉醒石和衣服</b>，等爬山再投入。',
        note: '针对“卡关”的取舍心态与资源规划。'
      }
    ]
  },
  {
    title: '过关・竞技场与刷分',
    blocks: [
      {
        title: '活动赛通关与大跳指南', url: 'https://tieba.baidu.com/p/8969809061', author: '百度贴吧',
        bullets: [
          '胜率的<b>基准线</b>判断。',
          '<b>以弱胜强</b>的打法与心态。',
          '不同 <b>A 技能</b>对新手通关的影响。',
          '<b>三体力潜力 + 输出卡</b>的局限。',
          '<b>回体声援卡</b>的使用与基准线突破。'
        ],
        note: '想稳定通关活动赛、用好“大跳”，先读这一篇。'
      },
      {
        title: '学习贴：前排学习 JJC 冠军配置打法攻略', url: 'http://jump2.bdimg.com/p/8770759954', author: '百度贴吧',
        bullets: [
          '只有<b>主手正属性攻击</b>能得分；主手反属性、副手攻击皆不得分。',
          '<b>沙包方</b>除主手正属性外其余攻击皆可被防御，从而最大化主手<b>倒转技能</b>收益。'
        ],
        note: '竞技场（JJC）玩家进阶参考。'
      },
      {
        title: '入坑日服记录贴三（涂油与配置分享）', url: 'https://www.tieba.com/p/8244540500', author: '百度贴吧',
        body: '分享配置供新入坑玩家参考：<b>艾米</b>涂两个 <b>15 技巧 EX 油</b>、<b>丽凤</b>涂三个 <b>5 体力油</b>，顶油拉满并把<b>魅力值提到上限</b>；换流行头饰时记得<b>装回 PP</b>。',
        note: '给出“涂油 + 声援板”成型后的面板参考。'
      },
      {
        title: '无聊氵一贴 为什么我的攻副这么水', url: 'https://tieba.baidu.com/p/8864419517', author: '百度贴吧',
        bullets: [
          '<b>攻副</b>＝队伍里的“进攻副手”。海咲不适合打攻副（易“捣乱”抢分）。',
          '把攻副换成<b>七海</b>，让七海 + 凪咲打<b>双攻</b>更稳。',
          '<b>防副</b>可用“玛小丽 + 紧凑实用防副绫音”，三队霞均分可稳定在 4 万左右。'
        ],
        note: '竞技场组队与攻副/防副分工。'
      }
    ]
  }
];
---

<Base title="社区攻略 · DOAXVV 攻略站" desc="贴吧 / B 站玩家攻略，按板块整理并标注来源。">
  <div class="container-wiki py-10">
    <p class="text-sm font-semibold text-pool-600">社区攻略</p>
    <h1 class="mt-1 text-3xl font-black" data-i18n="community.title">玩家攻略（来源标注）</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">
    <p class="mt-3 rounded-xl bg-pool-50 p-3 text-sm text-pool-800" data-i18n="ed.note"></p>
      内容整理自百度贴吧《死或生沙滩排球维纳斯假期吧》与 B 站专栏。每块均注明<b class="text-ink">标题、作者与来源链接</b>；文字为本站整理摘要，细节以原帖为准。
    </p>


    <h2 class="sec-h">攻略系统路线（从入坑到毕业）</h2>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-5">
      {roadmap.map((r) => (
        <div class="card-wiki p-5">
          <div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-gradient-to-br from-pool-500 to-pool-700 text-xs font-bold text-white">{r.n}</span><span class="text-sm font-extrabold">{r.title}</span></div>
          <p class="mt-1.5 text-xs text-ink-soft">{r.desc}</p>
          <div class="mt-3 space-y-1 text-xs">
            {r.posts.map((p) => <a href={p[1]} target="_blank" rel="noopener" class="block truncate font-semibold text-pool-600 no-underline hover:underline">{p[0]} ↗</a>)}
          </div>
          <a href={root + r.mod} class="mt-3 inline-block rounded-full bg-pool-50 px-3 py-1 text-xs font-bold text-pool-700 no-underline hover:bg-pool-100">相关站点 · {r.modLabel} →</a>
        </div>
      ))}
    </div>

    <h2 class="sec-h">新手常见问题（FAQ）</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      {faq.map((f) => (<div class="glass-card p-4"><p class="font-extrabold text-ink">Q：{f[0]}</p><p class="mt-1 text-sm text-ink-soft">A：{f[1]}</p></div>))}
    </div>

    <h2 class="sec-h">核心必读（高适用度）</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {core.map((c) => (
        <div class="glass-card p-5">
          <span class="badge badge-blush">推荐</span>
          <a href={c.u} target="_blank" rel="noopener" class="mt-2 block font-extrabold text-ink no-underline hover:underline">{c.t} ↗</a>
          <p class="mt-1 text-xs text-ink-soft">{c.a}</p>
          <p class="mt-2 text-xs text-ink-soft">{c.why}</p>
        </div>
      ))}
    </div>

    {sections.map((sec) => (
      <section class="mt-10">
        <h2 class="sec-h">{sec.title}</h2>
        <div class="space-y-5">
          {sec.blocks.map((b) => <SrcBlock {...b} />)}
        </div>
      </section>
    ))}

    <div class="mt-8 rounded-2xl border border-sand-300 bg-sand-200/40 p-6">
      <p class="font-bold text-sand-600">内容说明</p>
      <p class="mt-1 text-sm text-ink-soft">
        以上为社区讨论的整理摘要，观点随版本与数值变化，具体以原帖及当期游戏内容为准；如原帖地址失效，可在贴吧搜索对应标题。
      </p>
    </div>
  </div>
</Base>
