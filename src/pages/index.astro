---

import Base from '../layouts/Base.astro';
import CoastBackdrop from '../components/CoastBackdrop.astro';
import Icon from '../components/Icon.astro';
const root = import.meta.env.BASE_URL || '/';

const cards = [
  { href: '/girls', icon: 'girls', tk: 'home.card.girls', dk: 'home.card.girlsD' },
  { href: '/swimsuits', icon: 'swim', tk: 'home.card.swim', dk: 'home.card.swimD' },
  { href: '/guide', icon: 'guide', tk: 'home.card.guide', dk: 'home.card.guideD' },
  { href: '/community', icon: 'community', tk: 'home.card.community', dk: 'home.card.communityD' }
];
const quick = ['home.q1', 'home.q2', 'home.q3', 'home.q4'];
---

<Base title="DOAXVV 攻略站 · 首页">
  <section class="relative overflow-hidden">
    <CoastBackdrop full />
    <div class="container-wiki relative z-10 py-20 text-white sm:py-28">
      <p class="text-xs uppercase tracking-[0.2em] text-pool-100/80" data-i18n="home.kick">DEAD OR ALIVE Xtreme Venus Vacation</p>
      <h1 class="mt-4 max-w-2xl bg-gradient-to-b from-white via-white to-pool-100 bg-clip-text text-4xl font-black leading-tight text-transparent drop-shadow-lg sm:text-5xl" data-i18n="home.title">维纳斯群岛度假攻略站</h1>
      <p class="mt-5 max-w-xl text-pool-50/90" data-i18n="home.sub">《死或生 沙滩排球：维纳斯假期》攻略百科。</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={root + 'girls'} class="btn-primary" data-i18n="home.cta">浏览女孩图鉴 →</a>
        <a href={root + 'community'} class="inline-flex items-center gap-2 rounded-full border border-white/40 px-5 py-2.5 text-sm font-semibold text-white no-underline hover:bg-white/10" data-i18n="home.cta2">社区攻略</a>      </div>
    </div>
  </section>

  <section class="container-wiki -mt-10 px-4 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((c) => (
        <a href={root + c.href.slice(1)} class="card-wiki card-postcard group block p-5 no-underline">
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-pool-50 to-blush-200 text-pool-700 shadow-inner"><Icon name={c.icon} size={26} /></div>
          <h2 class="mt-3 text-base font-extrabold text-ink" data-i18n={c.tk}>{c.tk}</h2>
          <p class="mt-1 text-sm text-ink-soft" data-i18n={c.dk}>{c.dk}</p>
          <span class="mt-2 inline-block text-xs font-semibold text-pool-600 transition-transform group-hover:translate-x-1">进入 →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container-wiki py-12">
    <h2 class="text-2xl font-black" data-i18n="home.about">关于本作</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft" data-i18n="home.aboutBody">《DEAD OR ALIVE Xtreme Venus Vacation》是光荣特库摩推出的沙滩排球养成游戏。</p>
    <div class="card-wiki mt-6 p-6">
      <p class="font-bold text-ink" data-i18n="home.one">玩法一句话</p>
      <p class="mt-1 text-sm text-ink-soft" data-i18n="home.oneBody">组建二女海滩排球队伍，提升属性并赢取评价。</p>
    </div>
  </section>

  <section class="container-wiki pb-6">
    <h2 class="text-2xl font-black" data-i18n="home.quick">快速上手</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {quick.map((q, i) => <li class="flex items-center gap-3 rounded-2xl border border-line bg-white/90 p-4 text-sm shadow-sm backdrop-blur"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-gradient-to-br from-pool-400 to-pool-600 text-xs font-bold text-white">{i + 1}</span><span data-i18n={q}>{q}</span></li>)}
    </ul>
  </section>
</Base>