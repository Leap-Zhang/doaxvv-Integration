---
import Base from '../layouts/Base.astro';

const cards = [
  { href: '/girls', emoji: '👙', tk: 'home.card.girls', dk: 'home.card.girlsD' },
  { href: '/swimsuits', emoji: '👗', tk: 'home.card.swim', dk: 'home.card.swimD' },
  { href: '/guide', emoji: '📖', tk: 'home.card.guide', dk: 'home.card.guideD' },
  { href: '/community', emoji: '💬', tk: 'home.card.community', dk: 'home.card.communityD' }
];
const quick = ['home.q1', 'home.q2', 'home.q3', 'home.q4'];
---

<Base title="DOAXVV 攻略站 · 首页">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/img/hero_day.webp')" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-pool-900/95 via-pool-800/75 to-pool-600/40" aria-hidden="true"></div>
    <div class="container-wiki relative z-10 py-20 text-white sm:py-28">
      <p class="text-xs uppercase tracking-[0.2em] text-pool-100/80" data-i18n="home.kick">DEAD OR ALIVE Xtreme Venus Vacation</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-black leading-tight sm:text-5xl" data-i18n="home.title">维纳斯群岛度假攻略站</h1>
      <p class="mt-5 max-w-xl text-pool-50/90" data-i18n="home.sub">《死或生 沙滩排球：维纳斯假期》攻略百科。</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/girls" class="btn-primary" data-i18n="home.cta">浏览女孩图鉴 →</a>
        <a href="/community" class="inline-flex items-center gap-2 rounded-full border border-white/40 px-5 py-2.5 text-sm font-semibold text-white no-underline hover:bg-white/10" data-i18n="home.cta2">社区攻略</a>
      </div>
    </div>
  </section>

  <section class="container-wiki -mt-10 px-4 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((c) => (
        <a href={c.href} class="card-wiki block p-5 no-underline">
          <div class="text-3xl">{c.emoji}</div>
          <h2 class="mt-2 text-base font-extrabold text-ink" data-i18n={c.tk}>{c.tk}</h2>
          <p class="mt-1 text-sm text-ink-soft" data-i18n={c.dk}>{c.dk}</p>
          <span class="mt-2 inline-block text-xs font-semibold text-pool-600">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container-wiki py-12">
    <h2 class="text-2xl font-black" data-i18n="home.about">关于本作</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft" data-i18n="home.aboutBody">《DEAD OR ALIVE Xtreme Venus Vacation》是光荣特库摩推出的沙滩排球养成游戏。</p>
    <div class="card-wiki mt-6 p-6">
      <p class="font-bold text-ink" data-i18n="home.one">玩法一句话</p>
      <p class="mt-1 text-sm text-ink-soft" data-i18n="home.oneBody">组建二女海滩排球队伍，提升属性并赢取评价。</p>
    </div>
  </section>

  <section class="container-wiki pb-6">
    <h2 class="text-2xl font-black" data-i18n="home.quick">快速上手</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {quick.map((q) => <li class="rounded-xl border border-line bg-white p-4 text-sm" data-i18n={q}>{q}</li>)}
    </ul>
  </section>
</Base>