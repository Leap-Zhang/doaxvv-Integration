---

import Base from '../layouts/Base.astro';
import CoastBackdrop from '../components/CoastBackdrop.astro';
import official from '../data/official-news.json';
import Icon from '../components/Icon.astro';
import { changelog } from '../data/changelog.js';
const root = import.meta.env.BASE_URL || '/';

const cards = [
  { href: '/girls', icon: 'girls', tk: 'home.card.girls', dk: 'home.card.girlsD' },
  { href: '/swimsuits', icon: 'swim', tk: 'home.card.swim', dk: 'home.card.swimD' },
  { href: '/guide', icon: 'guide', tk: 'home.card.guide', dk: 'home.card.guideD' },
  { href: '/community', icon: 'community', tk: 'home.card.community', dk: 'home.card.communityD' },
  { href: '/skills', icon: 'skill', tk: 'home.card.skills', dk: 'home.card.skillsD' },
  { href: '/tools', icon: 'panel', tk: 'home.card.tools', dk: 'home.card.toolsD' },
  { href: '/reference', icon: 'economy', tk: 'home.card.reference', dk: 'home.card.referenceD' },
  { href: '/collection', icon: 'star', tk: 'home.card.collection', dk: 'home.card.collectionD' }
];
const catLabel = (c) => ({ gacha:'扭蛋', swimsuit:'泳装', event:'活动', version:'版本', maintenance:'维护', other:'其他' }[c] || c);
const catChip = (c) => ({ gacha:'badge-blush', swimsuit:'badge-pool', event:'badge-sand', version:'badge-pool', maintenance:'badge-blush', other:'badge-sand' }[c] || 'badge-sand');
const quick = ['home.q1', 'home.q2', 'home.q3', 'home.q4'];
---

<Base title="DOAXVV 攻略站 · 首页">
  <section class="relative overflow-hidden">
    <CoastBackdrop full />
    <div class="container-wiki relative z-10 py-20 text-white sm:py-28">
      <p class="text-xs uppercase tracking-[0.2em] text-pool-100/80" data-i18n="home.kick">DEAD OR ALIVE Xtreme Venus Vacation</p>
      <h1 class="mt-4 max-w-2xl bg-gradient-to-b from-white via-white to-pool-100 bg-clip-text text-4xl font-black leading-tight text-transparent drop-shadow-lg sm:text-5xl" data-i18n="home.title">维纳斯群岛度假攻略站</h1>
      <p class="mt-5 max-w-xl text-pool-50/90" data-i18n="home.sub">《死或生 沙滩排球：维纳斯假期》攻略百科。</p>
    </div>
  </section>

  <section class="container-wiki px-4 sm:px-6">
  <div class="card-wiki mt-2 p-5" style="border-color:rgba(200,78,116,.30)">
    <div class="flex flex-wrap items-center gap-2">
      <span class="badge badge-blush">官方公告</span>
      <span class="text-xs text-ink-soft">与官网首页一致 · 数据快照 {official.snapshot} · 每天自动刷新</span>
      <a href="https://game.doaxvv.com/cn/news_list/index.html" target="_blank" rel="noopener" class="ml-auto text-xs font-semibold text-pool-600 no-underline hover:underline">更多新闻 →</a>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div>
        <div class="flex items-center gap-2"><span class="badge badge-pool">最新信息</span><span class="text-xs text-ink-soft">{official.newsTop.length} 条</span></div>
        <ul class="mt-2 space-y-1.5">
          {official.newsTop.map((n) => (
            <li><a href={(n.url || '').replace(/^https?:\/\/[^/]+/, '')} target="_blank" rel="noopener" class="flex items-baseline gap-2 no-underline hover:underline"><span class="shrink-0 text-xs tabular-nums text-ink-soft">{n.date}</span><span class="truncate text-sm font-semibold text-pool-700">{n.title}</span></a></li>
          ))}
        </ul>
      </div>
      <div>
        <div class="flex items-center gap-2"><span class="badge badge-sand">版本更新</span><span class="text-xs text-ink-soft">{official.updTop.length} 条</span></div>
        <ul class="mt-2 space-y-1.5">
          {official.updTop.map((n) => (
            <li><a href={(n.url || '').replace(/^https?:\/\/[^/]+/, '')} target="_blank" rel="noopener" class="flex items-baseline gap-2 no-underline hover:underline"><span class="shrink-0 text-xs tabular-nums text-ink-soft">{n.date}</span><span class="truncate text-sm font-semibold text-pool-700">{n.title}</span></a></li>
          ))}
        </ul>
      </div>
    </div>

    <h3 class="mt-5 text-sm font-extrabold text-ink">历史公告（最近 {official.history.length} 条 · 按时间序）</h3>
    <details class="mt-2">
      <summary class="cursor-pointer text-xs font-semibold text-pool-600">展开 27 条历史 →</summary>
      <ul class="mt-2 space-y-1">
        {official.history.map((n) => (
          <li class="flex items-baseline gap-2 text-sm"><span class="shrink-0 text-xs tabular-nums text-ink-soft">{n.date}</span><a href={`/official/${(n.url || '').replace(/^.*\//, '').split('?')[0].replace(/\.html$/, '')}`} class="truncate font-medium text-ink no-underline hover:text-pool-700 hover:underline">{n.title}</a></li>
        ))}
      </ul>
    </details>
    <p class="mt-3 text-xs text-ink-soft">来源：<a href="https://game.doaxvv.com" target="_blank" rel="noopener" class="font-semibold text-pool-600 no-underline hover:underline">DOAXVV 官网</a>　·　更新信息 <a href="https://game.doaxvv.com/cn/update_list/index.html" target="_blank" rel="noopener" class="font-semibold text-pool-600 no-underline hover:underline">官网更新列表 →</a></p>
  </div>
</section>

  <section class="container-wiki mt-6 px-4 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((c) => (
        <a href={root + c.href.slice(1)} class="card-wiki card-postcard group block p-5 no-underline">
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-pool-50 to-blush-200 text-pool-700 shadow-inner"><Icon name={c.icon} size={26} /></div>
          <h2 class="mt-3 text-base font-extrabold text-ink" data-i18n={c.tk}>{c.tk}</h2>
          <p class="mt-1 text-sm text-ink-soft" data-i18n={c.dk}>{c.dk}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container-wiki mt-6 px-4 sm:px-6">
    <h2 class="text-2xl font-black" data-i18n="home.schedule">游戏日程</h2>
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      <div class="card-wiki p-5"><p class="font-bold">每日（19:00 UTC 刷新）</p><ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-ink-soft"><li>登录奖励 / 每日任务 / 折扣扭蛋次数重置</li><li>清空每日任务、领 FP 相关奖励</li></ul></div>
      <div class="card-wiki p-5"><p class="font-bold">每周（周一 19:00 UTC）</p><ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-ink-soft"><li>星等级魅力值排行重置</li><li>每周任务刷新</li></ul></div>
      <div class="card-wiki p-5"><p class="font-bold">活动期</p><ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-ink-soft"><li>限时扭蛋 / 商店 / 挑战赛按官方公告</li><li>爬山、生日、联动等活动周期</li></ul></div>
      <div class="card-wiki p-5"><p class="font-bold">养成节点</p><ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-ink-soft"><li>爬山（满破/PP）、友谊赛、课程</li><li>资源折算与囤货窗口</li></ul></div>
    </div>
    <p class="mt-2 text-xs text-ink-soft">详见 <a href={root + 'guide'} class="font-semibold text-pool-600 no-underline hover:underline">系统指南</a>。</p>
  </section>
  <section class="container-wiki py-12">
    <h2 class="text-2xl font-black" data-i18n="home.about">关于本作</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft" data-i18n="home.aboutBody">《DEAD OR ALIVE Xtreme Venus Vacation》是光荣特库摩推出的沙滩排球养成游戏。</p>
    <div class="card-wiki mt-6 p-6">
      <p class="font-bold text-ink" data-i18n="home.one">玩法一句话</p>
      <p class="mt-1 text-sm text-ink-soft" data-i18n="home.oneBody">组建二女海滩排球队伍，提升属性并赢取评价。</p>
    </div>
  </section>

  <section class="container-wiki pb-6">
    <h2 class="text-2xl font-black" data-i18n="home.quick">快速上手</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {quick.map((q, i) => <li class="flex items-center gap-3 rounded-2xl border border-line bg-white/90 p-4 text-sm shadow-sm backdrop-blur"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-gradient-to-br from-pool-400 to-pool-600 text-xs font-bold text-white">{i + 1}</span><span data-i18n={q}>{q}</span></li>)}
    </ul>
  </section>
  <section class="container-wiki py-8">
    <div class="flex items-center justify-between"><h2 class="text-2xl font-black" data-i18n="home.changelog">网站更新日志</h2><a href={root + 'updates'} class="text-xs font-semibold text-pool-600 no-underline hover:underline">全部 →</a></div>
    <div class="mt-4 space-y-3">
      {changelog.map((l) => (<div class="rounded-2xl border border-line bg-white p-4"><div class="flex items-center gap-2"><span class="badge badge-pool">{l[0]}</span><span class="text-xs text-ink-soft tabular-nums">{l[1]}</span></div><p class="mt-1 text-sm text-ink">{l[2]}</p></div>))}
    </div>
  </section>
</Base>