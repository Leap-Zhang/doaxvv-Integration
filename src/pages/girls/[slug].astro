---
import Base from '../../layouts/Base.astro';
import { girls, getGirl, girlIndex } from '../../data/girls.js';
import { getDoax } from '../../data/doax.js';

export function getStaticPaths() {
  return girls.map((g) => ({ params: { slug: g.id }, props: { id: g.id } }));
}

const { id } = Astro.props;
const g = getGirl(id)!;
const d = getDoax(id);
if (d) g.type = d.type === 'pow' ? '力量型' : d.type === 'tec' ? '技巧型' : '体力型';
const idx = girlIndex(id);
const prev = girls[idx - 1];
const next = girls[idx + 1];

const maxBar = 1450;
const statRows = [
  { label: 'POW 力量', key: 'pow', color: '#e56a92' },
  { label: 'TEC 技巧', key: 'tec', color: '#3f9d6f' },
  { label: 'STM 体力', key: 'stm', color: '#dfa53c' }
];
const base = d ? { pow: d.pow.lv1, tec: d.tec.lv1, stm: d.stm.lv1, apl: d.appeal.lv1 } : g.base;
const max100 = d ? { pow: d.pow.lv100, tec: d.tec.lv100, stm: d.stm.lv100, apl: d.appeal.lv100 } : null;
---

<Base title={`${g.name} · 女孩图鉴 · DOAXVV 攻略站`} desc={`${g.name}（${g.romaji}）角色资料、基础数值与培养笔记。`}>
  <div class="container-wiki py-10">
    <nav class="text-sm text-ink-soft">
      <a href="/" class="no-underline">首页</a> / <a href="/girls" class="no-underline">女孩图鉴</a> / <span class="text-ink">{g.name}</span>
    </nav>

    <div class="mt-5 grid gap-8 lg:grid-cols-[300px_1fr]">
      <div>
        <div class="card-wiki overflow-hidden">
          <div class="grid h-72 place-items-center bg-gradient-to-br from-pool-50 to-pool-100">
            {g.img
              ? <img src={g.img} alt={g.name} class="h-72 w-full object-cover" />
              : <span class="text-7xl font-black text-pool-300">{g.name.charAt(0)}</span>}
          </div>
          <div class="p-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2"><h1 class="text-2xl font-black" data-name-id={g.id}>{g.name}</h1><button id="favGirl" style="border:none;background:transparent;cursor:pointer;font-size:20px;color:#e6a04c" title="收藏/取消">☆</button></div>
              <span class:list={['badge', g.category === '初始' ? 'badge-blush' : 'badge-sand']}>{g.category === '初始' ? '初始' : '追加'}</span>
            </div>
            <p class="text-sm text-ink-soft">{g.jp} · {g.romaji}</p>
          </div>
        </div>
        <div class="mt-3 flex gap-2">
          {prev && <a href={`/girls/${prev.id}`} class="badge badge-pool no-underline">← {prev.name}</a>}
          {next && <a href={`/girls/${next.id}`} class="badge badge-pool no-underline">{next.name} →</a>}
        </div>
      </div>

      <div class="space-y-6">
        <div class="card-wiki p-6">
          <p class="text-xs font-semibold text-pool-600">资料</p>
          <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
            <div class="flex justify-between border-b border-line pb-1"><dt class="text-ink-soft">声优</dt><dd class="font-semibold">{d?.cv || g.cv}</dd></div>
            <div class="flex justify-between border-b border-line pb-1"><dt class="text-ink-soft">生日</dt><dd class="font-semibold">{d?.birthday || g.birthday}</dd></div>
            <div class="flex justify-between border-b border-line pb-1"><dt class="text-ink-soft">年龄</dt><dd class="font-semibold">{d?.age || g.age}</dd></div>
            <div class="flex justify-between border-b border-line pb-1"><dt class="text-ink-soft">身高</dt><dd class="font-semibold">{d?.height || g.height}</dd></div>
            <div class="flex justify-between border-b border-line pb-1"><dt class="text-ink-soft">三围</dt><dd class="font-semibold">{d ? `${d.bust}/${d.waist}/${d.hip}` : g.size}</dd></div>
            <div class="flex justify-between border-b border-line pb-1"><dt class="text-ink-soft">血型</dt><dd class="font-semibold">{d?.blood || '—'}</dd></div>
            <div class="flex justify-between border-b border-line pb-1"><dt class="text-ink-soft">属性偏向</dt><dd class="font-semibold text-pool-700" data-type-label={g.type}>{g.type}</dd></div>
          </dl>
          <p class="mt-4 leading-relaxed text-ink-soft">{g.profile}</p>
          <div class="mt-3 flex flex-wrap gap-2">{g.tags.map((t) => <span class="badge badge-pool">{t}</span>)}</div>
        </div>

        <div class="card-wiki p-6">
          <p class="text-xs font-semibold text-pool-600">初始数值（基础 · Lv1）</p>
          {base ? (
            <>
              <div class="mt-4">
                {statRows.map((r) => {
                  const val = base[r.key];
                  const w = Math.min(100, Math.round((val / 1450) * 100));
                  return (
                    <div class="mb-3">
                      <div class="mb-1 flex justify-between text-sm">
                        <span class="font-semibold">{r.label}</span>
                        <span class="font-bold">{val}</span>
                      </div>
                      <div class="stat-bar">
                        <span class="stat-fill" style={`width:${w}%;background:${r.color}`}></span>
                      </div>
                    </div>
                  );
                })}
              </div>
              <p class="mt-2 text-sm text-ink-soft">APL 潜力上限：<b>{base.apl}</b>　·　数值来源：doax.cc</p>
            </>
          ) : (
            <p class="mt-4 text-ink-soft">待补充（h1g 基础数值数据整理中）。</p>
          )}
        </div>

        {max100 && (
          <div class="card-wiki p-6">
            <p class="text-xs font-semibold text-pool-600">满级基础（Lv.100 · doax.cc）</p>
            <div class="mt-4">
              {statRows.map((r) => {
                const val = max100[r.key];
                const w = Math.min(100, Math.round((val / 5000) * 100));
                return (
                  <div class="mb-3">
                    <div class="mb-1 flex justify-between text-sm">
                      <span class="font-semibold">{r.label}</span>
                      <span class="font-bold">{val}</span>
                    </div>
                    <div class="stat-bar">
                      <span class="stat-fill" style={`width:${w}%;background:${r.color}`}></span>
                    </div>
                  </div>
                );
              })}
            </div>
            <p class="mt-2 text-sm text-ink-soft">APL：<b>{max100.apl}</b>　·　合计：<b>{d.total.lv100}</b></p>
          </div>
        )}

        <div class="card-wiki p-6">
          <p class="text-xs font-semibold text-pool-600">理论最高数值</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">
            女孩“理论最高”＝<b class="text-ink">基础(Lv1) + 满级成长 + 满强化装备 + 满潜力PP + 涂油 + 应援板</b>，随配装与版本变化，并非固定值。参考：单项<b class="text-ink">满强化SSR泳装</b> Lv.90 即可到 <b class="text-ink">4000+</b>（如环「Vintage Noctiluca」为 4442/3794/3864）。本站暂以基础数值呈现，精确上限请在游戏内按配装计算。
          </p>
        </div>

        <div class="card-wiki p-6">
          <p class="text-xs font-semibold text-pool-600">培养笔记（社区）</p>
          <p class="mt-3 text-sm">
            属性偏向：<b class="text-ink" data-type-label={g.type}>{g.type}</b>
            {g.note.src && <> · 来源：<a href={g.note.src.url} target="_blank" rel="noopener" class="font-semibold">{g.note.src.title}</a>{g.note.src.author && <>（{g.note.src.author}）</>}</>}
          </p>
          {g.note.bullets?.length ? (
            <ul class="mt-3 list-disc pl-5 text-sm text-ink-soft">
              {g.note.bullets.map((b) => <li class="mb-1.5">{b}</li>)}
            </ul>
          ) : (
            <p class="mt-3 text-sm text-ink-soft">培养要点暂缺，后续补充。</p>
          )}
        </div>

        <div class="card-wiki p-6">
          <p class="text-xs font-semibold text-pool-600">我的备注</p>
          <textarea id="noteGirl" rows="3" class="mt-3 w-full rounded-lg border border-line bg-white/70 px-3 py-2 text-sm outline-none"></textarea>
        </div>
      </div>
    </div>
  </div>

  <section class="card-wiki p-6">
    <p class="text-xs font-semibold text-pool-600">她的泳装</p>
    <div id="gSuits" data-girl={id} class="mt-3"></div>
  </section>

  <script>
    import { girlSuitKey, suitName, openSuitModal, buildSkillMap } from '../../lib/suitModal.js';
    (async () => {
      const girlEl = document.getElementById('gSuits');
      const girlId = girlEl ? girlEl.getAttribute('data-girl') : '';
      const base = document.documentElement.getAttribute('data-base') || '/';
      const [suits, skillData, girlNames] = await Promise.all([
        fetch(base + 'data/doax-ssr.json').then((r) => r.json()),
        fetch(base + 'data/doax-skills.json').then((r) => r.json()),
        fetch(base + 'data/girl-names.json').then((r) => r.json())
      ]).catch(() => [null, null, null]);
      if (!suits) return;
      const key = girlSuitKey(girlId);
      const mine = suits.filter((s) => s.girl === key).slice(0, 24);
      const skillMap = buildSkillMap(skillData);
      const girlImg = {}; girlImg[key] = base + 'img/bromide/girls/' + girlId + '.webp';
      const binds = { girlNames, girlImg, base };
      if (!mine.length) { girlEl.innerHTML = '<p class="text-sm text-ink-soft">暂无收录的泳装。 <a href="' + base + 'swimsuits/">去图鉴</a></p>'; return; }
      girlEl.innerHTML = '<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">' + mine.map((s) =>
        '<div class="card-wiki cursor-pointer p-4" data-id="' + s.id + '"><div class="font-extrabold text-pool-700">' + suitName(s, window.__LANG || 'zh') + '</div><div class="text-xs text-ink-soft">' + (s.jp || '') + '</div><div class="mt-2 space-y-1 text-sm"><div class="flex justify-between"><span>POW</span><b>' + s.pow + '</b></div><div class="flex justify-between"><span>TEC</span><b>' + s.tec + '</b></div><div class="flex justify-between"><span>STM</span><b>' + s.stm + '</b></div></div></div>'
      ).join('') + '</div>';
      girlEl.querySelectorAll('[data-id]').forEach((el) => {
        const s = mine.find((x) => x.id === el.getAttribute('data-id'));
        el.addEventListener('click', () => openSuitModal(s, skillMap, window.__LANG || 'zh', binds));
      });
    })();
  </script>


  <script>
    import { isFav, toggleFav } from "../../lib/fav.js";
    import { getNote, setNote } from "../../lib/notes.js";
    (() => {
      const b = document.getElementById("favGirl");
      const gid = b.getAttribute("data-g") || (document.querySelector("[data-name-id]") && document.querySelector("[data-name-id]").getAttribute("data-name-id"));
      if (!b || !gid) return;
      b.setAttribute("data-g", gid);
      b.textContent = isFav("girls", gid) ? "★" : "☆";
      b.addEventListener("click", () => { toggleFav("girls", gid); b.textContent = isFav("girls", gid) ? "★" : "☆"; });
      const nt = document.getElementById('noteGirl'); if (nt && gid) { nt.value = getNote('girls', gid); nt.addEventListener('input', () => setNote('girls', gid, nt.value)); }
    })();
  </script>
</Base>
