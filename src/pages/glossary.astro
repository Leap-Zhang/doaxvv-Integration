---
import Base from '../layouts/Base.astro';

const terms = [
  ['岛主', 'Owner', 'オーナー'],
  ['女孩 / 女神', 'Girl / Venus', 'ガール / ヴィーナス'],
  ['挑战赛 / 赛事', 'Festival', 'フェス / 大会'],
  ['力量', 'Power / POW', 'パワー'],
  ['技巧', 'Technique / TEC', 'テクニック'],
  ['体力', 'Stamina / STM', 'スタミナ'],
  ['魅力 / 魅力值', 'Appeal / APL', 'アピール'],
  ['杀球', 'Spike', 'スパイク'],
  ['假动作', 'Feint', 'フェイント'],
  ['情绪条', 'Tension gauge', 'テンションゲージ'],
  ['情绪高涨', 'Tension burst', 'ハイテンション'],
  ['流行', 'Trend', 'トレンド'],
  ['泳装', 'Swimsuit', '水着'],
  ['饰品', 'Accessory', 'アクセサリー'],
  ['潜力', 'Potential', '潜在能力'],
  ['PP / 潜力点', 'PP', 'PP'],
  ['技能觉醒', 'Skill Awaken', 'スキル覚醒'],
  ['满破 / 毕业', 'Full Break', '完凸 / 完走'],
  ['爬山', 'Climb (event)', '登山'],
  ['涂油 / 护肤', 'Skincare oil', 'スキンケアオイル'],
  ['声援板', 'Cheer board', '応援ボード'],
  ['王牌', 'Ace', 'エース'],
  ['嘉宾', 'Guest', 'ゲスト'],
  ['写真 / 佳人玉照', 'Photo', '写真 / ブロマイド'],
  ['篇章', 'Episode', 'エピソード'],
  ['魅力值评价', 'Appeal ranking', 'アピール評価'],
  ['F技 / 狂热技能', 'Fever skill', 'フィーバースキル'],
  ['攻副', 'Offense sub', '攻撃サブ'],
  ['防副', 'Defense sub', '防御サブ']
];
---

<Base title="术语表 · DOAXVV 攻略站" desc="中/英/日 术语对照。">
  <div class="container-wiki py-10">
    <p class="text-sm font-semibold text-pool-600">术语表</p>
    <h1 class="mt-1 text-3xl font-black">术语表（中 / 英 / 日）</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">DOAXVV 常用术语对照。数据与界面多语、术语一致性参考。</p>
    <input id="gSearch" type="search" placeholder="搜索术语…" class="mt-5 w-full max-w-xs rounded-full border border-line bg-white px-4 py-2.5 text-sm outline-none focus:border-pool-400" />
    <table class="tbl mt-4" id="gTable">
      <thead><tr><th>中文</th><th>English</th><th>日本語</th></tr></thead>
      <tbody>
        {terms.map((t) => <tr><td>{t[0]}</td><td>{t[1]}</td><td>{t[2]}</td></tr>)}
      </tbody>
    </table>
  </div>
  <script>
    const q = document.getElementById('gSearch');
    q.addEventListener('input', () => {
      const s = q.value.trim().toLowerCase();
      document.querySelectorAll('#gTable tbody tr').forEach((tr) => { tr.style.display = !s || tr.innerText.toLowerCase().includes(s) ? '' : 'none'; });
    });
  </script>
</Base>
