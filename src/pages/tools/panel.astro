---
import Base from '../../layouts/Base.astro';
---

<Base title="面板估算器 · 工具 · DOAXVV 攻略站" desc="选角色+泳装+加成，估算面板。">
  <div class="container-wiki py-10">
    <p class="text-sm font-semibold text-pool-600">工具</p>
    <h1 class="mt-1 text-3xl font-black">面板估算器</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">选角色与一件 SSR 泳装，叠加潜力 / 涂油加成，估算面板（简化模型，仅供量级参考）。泳装按所选角色按需加载。</p>

    <div class="card-wiki mt-6 p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="text-sm"><span class="text-ink-soft">角色</span>
          <select id="pGirl" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm outline-none"></select>
        </label>
        <label class="text-sm"><span class="text-ink-soft">泳装</span>
          <select id="pSuit" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm outline-none"></select>
        </label>
      </div>
      <div class="mt-4 grid grid-cols-3 gap-3">
        {[['力量','pP'],['技巧','pT'],['体力','pS']].map(([lb,id]) => (
          <label class="text-sm"><span class="text-ink-soft">{lb} 潜力 %</span>
            <input id={id} type="number" min="0" value="0" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm outline-none" />
          </label>
        ))}
      </div>
      <div class="mt-3 grid grid-cols-3 gap-3">
        {[['力量','oP'],['技巧','oT'],['体力','oS']].map(([lb,id]) => (
          <label class="text-sm"><span class="text-ink-soft">{lb} 涂油 %</span>
            <input id={id} type="number" min="0" value="0" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm outline-none" />
          </label>
        ))}
      </div>
    </div>

    <div id="pOut" class="card-wiki mt-6 p-6 text-sm"></div>
    <div class="mt-4 rounded-xl bg-pool-50 p-4 text-xs text-pool-800">估算 = 角色 LV100 基础 + 泳装，再 ×(1 + 潜力% + 涂油%)。未含流行奖励 / 属性倾向 / 应援板 / 装饰写真 / 技能，以及比赛攻防与情绪公式；APL 魅力不随潜力%放大，单独列出。结果仅供量级参考。</div>
  </div>

  <script>
    import { suitName } from '../../lib/suitModal.js';
    (async () => {
      const base = document.documentElement.getAttribute('data-base') || '/';
      let girls = [];
      try { girls = await fetch(base + 'api/doax-girls.json').then((r) => r.json()); } catch (e) { girls = []; }
      const girlSel = document.getElementById('pGirl');
      const suitSel = document.getElementById('pSuit');
      const out = document.getElementById('pOut');
      const LANG = window.__LANG || 'zh';
      girls.forEach((g) => { const o = document.createElement('option'); o.value = g.id; o.textContent = g.name; girlSel.appendChild(o); });
      girlSel.disabled = !girls.length;

      let currentGirl = null, currentSuit = null, suits = [];
      const val = (id) => parseFloat(document.getElementById(id).value) || 0;

      async function fillSuits() {
        const gid = girlSel.value;
        currentGirl = girls.find((g) => g.id === gid) || null;
        suitSel.innerHTML = '';
        suitSel.disabled = true;
        suits = [];
        try { suits = await fetch(base + 'api/suits/' + gid + '.json').then((r) => r.json()); }
        catch (e) { suits = []; }
        if (!Array.isArray(suits)) suits = [];
        suits.forEach((s) => { const o = document.createElement('option'); o.value = s.id; o.textContent = s.pow + '/' + s.tec + '/' + s.stm + '　' + suitName(s, LANG); suitSel.appendChild(o); });
        suitSel.disabled = !suits.length;
        currentSuit = suits.find((s) => s.id === suitSel.value) || suits[0] || null;
        render();
      }

            const CLS = { pow: 'attr-pow', tec: 'attr-tec', stm: 'attr-stm', apl: 'attr-apl' };
      const typeChip = (t) => ({ pow: 'chip-pow', tec: 'chip-tec', stm: 'chip-stm', apl: 'chip-apl' }[t] || 'badge-sand');
      const typeLabel = (t) => ({ pow: '力量型', tec: '技巧型', stm: '体力型' }[t] || '—');
      function render() {
        if (!currentGirl || !currentSuit) { out.innerHTML = '<p class="text-ink-soft">该角色暂无泳装数据。</p>'; return; }
        const g = currentGirl, s = currentSuit;
        const attrs = [
          { key: 'pow', lb: 'POW 力量', gb: g.pow.lv100, sv: s.pow, pot: 'pP', oil: 'oP' },
          { key: 'tec', lb: 'TEC 技巧', gb: g.tec.lv100, sv: s.tec, pot: 'pT', oil: 'oT' },
          { key: 'stm', lb: 'STM 体力', gb: g.stm.lv100, sv: s.stm, pot: 'pS', oil: 'oS' },
          { key: 'apl', lb: 'APL 魅力', gb: g.appeal.lv100, sv: s.apl, pot: '', oil: '' }
        ];
        const rows = attrs.map((a) => {
          const combined = a.gb + a.sv;
          const adj = a.key === 'apl' ? combined : Math.round(combined * (1 + (val(a.pot) + val(a.oil)) / 100));
          return Object.assign({}, a, { combined, adj });
        });
        const total = rows.reduce((t, r) => t + r.adj, 0);
        out.innerHTML =
          '<p class="font-bold">' + g.name + '（' + typeLabel(g.type) + '） · ' + suitName(s, LANG) + ' <span class="badge ' + typeChip(s.type) + '">' + (s.type || '').toUpperCase() + '</span></p>' +
          '<table class="tbl mt-3 w-full"><thead><tr><th>属性</th><th>角色基础(Lv100)</th><th>泳装</th><th>基础+泳装</th><th>加成后</th></tr></thead><tbody>' +
          rows.map((r) => '<tr><td class="font-semibold ' + CLS[r.key] + '">' + r.lb + '</td><td>' + r.gb + '</td><td>' + r.sv + '</td><td>' + r.combined + '</td><td><b class="' + CLS[r.key] + '">' + r.adj + '</b></td></tr>').join('') +
          '<tr><td class="font-semibold">合计</td><td></td><td></td><td></td><td><b class="text-pool-700">' + total + '</b></td></tr>' +
          '</tbody></table>' +
          (s.skills && s.skills.length ? '<p class="mt-2 text-xs text-ink-soft">技能：<span class="font-semibold text-ink">' + s.skills.join('　·　') + '</span></p>' : '') +
          '<p class="mt-2 text-xs text-ink-soft">APL 魅力不随潜力%/涂油%放大；未含流行奖励、应援板、装饰写真、技能效果与比赛攻防公式。结果仅供量级参考。</p>';
      }

      girlSel.addEventListener('change', fillSuits);
      suitSel.addEventListener('change', () => { currentSuit = suits.find((s) => s.id === suitSel.value); render(); });
      ['pP', 'pT', 'pS', 'oP', 'oT', 'oS'].forEach((id) => document.getElementById(id).addEventListener('input', render));
      fillSuits();
    })();
  </script>
</Base>