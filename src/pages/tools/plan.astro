---
import Base from '../../layouts/Base.astro';
---

<Base title="满破 / PP 规划器 · 工具 · DOAXVV 攻略站" desc="按目标饰品PP容量推荐减体潜力搭配。">
  <div class="container-wiki py-10">
    <p class="text-sm font-semibold text-pool-600">工具</p>
    <h1 class="mt-1 text-3xl font-black">满破 / PP 规划器</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">给定饰品 PP 容量与可选“减体潜力”PP 值，找出“总和 ≤ 容量且尽量填满”的搭配（每种 PP 值至多使用一次）。</p>

    <div class="card-wiki mt-6 p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="text-sm"><span class="text-ink-soft">饰品 PP 容量</span>
          <input id="cap" type="number" value="19" min="1" max="120" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm outline-none" />
        </label>
        <label class="text-sm"><span class="text-ink-soft">可选减体潜力 PP（逗号分隔，每种至多 1 次）</span>
          <input id="vals" value="13,12,11,10,9,8,7,6,5,4,3,2" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm outline-none" />
        </label>
      </div>
    </div>

    <div id="plOut" class="card-wiki mt-6 p-6 text-sm"></div>
    <div class="mt-4 rounded-xl bg-pool-50 p-4 text-xs text-pool-800">示例：容量 19、已装 13PP 后余 6，可用 4 + 2（=6）补满；或若 13PP 已用，用 12 + 5 + 2（=19）填满。算法会直接列出“最接近容量”的若干组合，避免手动推算；最多只取前 18 个 PP 值以防过大输入。</div>
  </div>

  <script>
    const capEl = document.getElementById('cap');
    const valsEl = document.getElementById('vals');
    const out = document.getElementById('plOut');
    function bestFill(capacity, values) {
      const uniq = [...new Set(values)].filter((v) => Number.isFinite(v) && v > 0 && v <= capacity).sort((a, b) => b - a);
      const limit = Math.min(uniq.length, 18);
      const arr = uniq.slice(0, limit);
      const n = arr.length;
      let bestSum = 0;
      const combos = [];
      (function dfs(i, sum, cur) {
        if (sum > capacity) return;
        if (sum > bestSum) { bestSum = sum; combos.length = 0; combos.push(cur.slice()); }
        else if (sum === bestSum && combos.length < 8) combos.push(cur.slice());
        for (let j = i; j < n; j++) dfs(j + 1, sum + arr[j], cur.concat(arr[j]));
      })(0, 0, []);
      return { sum: bestSum, combos, truncated: uniq.length > limit };
    }
    function render() {
      const cap = parseInt(capEl.value, 10);
      if (!cap || cap < 1) { out.innerHTML = ''; return; }
      const values = valsEl.value.split(',').map((x) => parseInt(x.trim(), 10)).filter((x) => !isNaN(x));
      const r = bestFill(cap, values);
      out.innerHTML = '<p class="font-bold">目标容量：' + cap + '</p>' +
        '<p class="mt-2">可填满到 <b class="text-pool-700">' + r.sum + '</b>（' + (r.sum === cap ? '已填满，无浪费' : '浪费 ' + (cap - r.sum)) + '）</p>' +
        (r.truncated ? '<p class="mt-1 text-xs text-ink-soft">可选值较多，仅考虑前 18 大 PP 值。</p>' : '') +
        (r.combos.length
          ? '<p class="mt-3 text-xs text-ink-soft">组合（每种 PP 至多一次）：</p><ul class="mt-2 list-disc pl-5">' + r.combos.map((c) => '<li>' + c.slice().sort((a, b) => b - a).join(' + ') + ' = ' + c.reduce((a, b) => a + b, 0) + '</li>').join('') + '</ul>'
          : '<p class="mt-3 text-ink-soft">未找到可用组合，请检查可选 PP 或调大容量。</p>');
    }
    capEl.addEventListener('input', render);
    valsEl.addEventListener('input', render);
    render();
  </script>
</Base>