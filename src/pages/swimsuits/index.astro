---

import Base from '../../layouts/Base.astro';
import { girls } from '../../data/girls.js';
import girlNames from '../../data/girl-names.json';
import skillData from '../../data/doax-skills.json';
import { buildSkillMap } from '../../lib/suitModal.js';
import { readdirSync } from 'node:fs';
const root = import.meta.env.BASE_URL || '/';

const GKEY = { helena: 'elena', marie: 'marierose', meg: 'megu' };
const types = ['全部', 'pow', 'tec', 'stm', 'apl'];
const girlNameMap = Object.fromEntries(Object.entries(girlNames).map(([id, n]) => [id, n]));
Object.entries(GKEY).forEach(([k, v]) => { girlNameMap[k] = girlNames[v]; });
const girlImg = Object.fromEntries(girls.map((g) => [g.id, root + 'img/bromide/girls/' + g.id + '.webp']));
Object.entries(GKEY).forEach(([k, v]) => { girlImg[k] = girlImg[v]; });
const skillMap = buildSkillMap(skillData);
const starIds = new Set(readdirSync('public/img/bromide/star').map((x) => x.replace(/\.(png|webp)$/, '')));
const suitCount = 3191;
---

<Base title="DOAXVV 攻略站 · 泳装图鉴" desc="doax.cc 泳装数据全量图鉴。">
  <div class="container-wiki py-10">
    <p class="text-sm font-semibold text-pool-600" data-i18n="admin.swimsuits">泳装图鉴</p>
    <h1 class="mt-1 text-3xl font-black" data-i18n="swim.title">泳装・饰品图鉴</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">共 <b class="text-ink">{suitCount}</b> 件 SSR 泳装（数据来源：doax.cc）。</p>

    <h2 class="sec-h">筛选</h2>
    <div class="flex flex-wrap items-center gap-3">
      <input id="sSearch" type="search" placeholder="搜索泳装名…" class="w-full max-w-xs rounded-full border border-line bg-white/70 px-4 py-2.5 text-sm outline-none focus:border-pool-400" />
      <select id="sGirl" class="rounded-full border border-line bg-white/70 px-3 py-2 text-sm outline-none">
        <option value="全部">{ '全部角色' }</option>
        {girls.map((g) => <option value={g.id}>{g.name}</option>)}
      </select>
      <div id="sType" class="flex gap-2">
        {types.map((t, i) => (
          <button data-type={t} class:list={['badge cursor-pointer', i === 0 ? 'badge-pool' : 'bg-white/70 text-ink-soft border border-line']}>
            {t === '全部' ? '全部' : t.toUpperCase()}
          </button>
        ))}
      </div>
      <span id="sCount" class="text-sm text-ink-soft"></span>
    </div>

    <div class="mt-4 flex flex-wrap items-end gap-3">
      <label class="text-xs text-ink-soft">技能 <input id="sSkill" type="search" placeholder="技能关键词…" class="w-36 rounded-full border border-line bg-white/70 px-3 py-2 text-sm outline-none" /></label>
      <label class="text-xs text-ink-soft">最低 POW <input id="sPow" type="number" min="0" placeholder="0" class="w-24 rounded-full border border-line bg-white/70 px-3 py-2 text-sm outline-none" /></label>
      <label class="text-xs text-ink-soft">最低 TEC <input id="sTec" type="number" min="0" placeholder="0" class="w-24 rounded-full border border-line bg-white/70 px-3 py-2 text-sm outline-none" /></label>
      <label class="text-xs text-ink-soft">最低 STM <input id="sStm" type="number" min="0" placeholder="0" class="w-24 rounded-full border border-line bg-white/70 px-3 py-2 text-sm outline-none" /></label>
      <label class="text-xs text-ink-soft">最低 APL <input id="sApl" type="number" min="0" placeholder="0" class="w-24 rounded-full border border-line bg-white/70 px-3 py-2 text-sm outline-none" /></label>
      <label class="text-xs text-ink-soft">排序 <select id="sSort" class="rounded-full border border-line bg-white/70 px-3 py-2 text-sm outline-none"><option value="默认">默认</option><option value="pow">POW ↓</option><option value="tec">TEC ↓</option><option value="stm">STM ↓</option><option value="apl">APL ↓</option></select></label>
      <label class="text-xs text-ink-soft">发售年 <select id="sYear" class="rounded-full border border-line bg-white/70 px-3 py-2 text-sm outline-none"><option value="全部">全部</option></select></label>
      <button id="sReset" class="badge icon cursor-pointer">重置</button>
    </div>

    <div class="stage mt-5">
      <div id="sList" class="grid gap-3 sm:grid-cols-3 lg:grid-cols-4"></div>
      <button id="sMore" class="mt-5 w-full rounded-full border border-white/60 bg-white/60 py-3 text-sm font-semibold text-pool-600 backdrop-blur-xl hover:bg-white/80">加载更多</button>
    </div>

    <div class="mt-8 rounded-2xl border border-line bg-white p-6 text-sm text-ink-soft">
      数据来源：<a href="https://doax.cc/ssr" target="_blank" rel="noopener" class="font-semibold text-pool-600">doax.cc 泳装图鉴</a>（已本地化）。
    </div>
  </div>

  <div id="sMeta" hidden>{JSON.stringify({ girlNames: girlNameMap, girlImg, skillMap, starIds: [...starIds] })}</div>
  <script>
    import { suitName, girlDisplayName, openSuitModal, skillText, skillPropClass } from '../../lib/suitModal.js';
    import { isFav, toggleFav } from '../../lib/fav.js';
    (async () => {
      const meta = JSON.parse(document.getElementById('sMeta').textContent);
      const girlNames = meta.girlNames, girlImg = meta.girlImg, skillMap = meta.skillMap;
      const star = new Set(meta.starIds);
      const LANG = window.__LANG || 'zh';
      const NEW_YEAR = new Date().getFullYear() - 1;
      const isNew = (s) => parseInt(String(s.sell || '').slice(0, 4), 10) >= NEW_YEAR;
      const binds = { girlNames, girlImg, base: (document.documentElement.getAttribute('data-base') || '/') };
      const suits = await fetch((document.documentElement.getAttribute('data-base') || '/') + 'data/doax-ssr.json').then((r) => r.json());
      const girlSel = document.getElementById('sGirl'), search = document.getElementById('sSearch'), typeBox = document.getElementById('sType');
      const list = document.getElementById('sList'), more = document.getElementById('sMore'), countEl = document.getElementById('sCount');
      const sSkill = document.getElementById('sSkill'), sPow = document.getElementById('sPow'), sTec = document.getElementById('sTec'), sStm = document.getElementById('sStm'), sApl = document.getElementById('sApl'), sSort = document.getElementById('sSort'), sReset = document.getElementById('sReset'), sYear = document.getElementById('sYear');
      let girl = '全部', type = '全部', qtext = '', shown = 36;
      let skillQ = '', minPow = '', minTec = '', minStm = '', minApl = '', sort = '默认', year = '全部';
      const filtered = () => {
        let arr = suits.filter((s) => {
          const okG = girl === '全部' || s.girl === girl;
          const okT = type === '全部' || s.type === type;
          const okQ = !qtext || (s.name + ' ' + s.name_en + ' ' + s.name_ja + ' ' + girlDisplayName(s.girl, girlNames, LANG)).toLowerCase().includes(qtext);
          const okSk = !skillQ || (s.skills || []).join(' ').toLowerCase().includes(skillQ);
          const okPow = minPow === '' || s.pow >= Number(minPow);
          const okTec = minTec === '' || s.tec >= Number(minTec);
          const okStm = minStm === '' || s.stm >= Number(minStm);
          const okApl = minApl === '' || s.apl >= Number(minApl);
          const okYear = year === '全部' || String(s.sell || '').slice(0, 4) === year;
          return okG && okT && okQ && okSk && okPow && okTec && okStm && okApl && okYear;
        });
        if (sort !== '默认') arr = [...arr].sort((a, b) => b[sort] - a[sort]);
        return arr;
      };
      const statTile = (l, v, c) => '<div class="rounded-lg bg-white/50 py-1"><div class="text-[10px] text-ink-soft">' + l + '</div><div class="' + (c || '') + ' text-xs font-bold">' + v + '</div></div>';
      function render() {
        const f = filtered();
        countEl.textContent = '共 ' + f.length + ' 件';
        list.innerHTML = '';
        f.slice(0, shown).forEach((s) => {
          const el = document.createElement('div');
          el.className = 'glass-card cursor-pointer p-3'; el.style.position = 'relative';
          const typeChip = { pow: 'chip-pow', tec: 'chip-tec', stm: 'chip-stm', apl: 'chip-apl' }[s.type] || 'badge-pool';
          el.innerHTML =
            '<div class="flex items-center gap-2"><img src="' + (star.has(s.id) ? (document.documentElement.getAttribute('data-base') || '/') + 'img/bromide/star/' + s.id + '.webp' : (girlImg[s.girl] || '')) + '" alt="' + girlDisplayName(s.girl, girlNames, LANG) + '" loading="lazy" decoding="async" class="h-11 w-11 rounded-lg object-cover" onerror="this.style.display=\'none\'" /><div class="min-w-0 flex-1"><div class="truncate text-sm font-extrabold text-pool-700">' + suitName(s, LANG) + '</div><div class="truncate text-[11px] text-ink-soft">' + (girlNames[s.girl] ? girlDisplayName(s.girl, girlNames, LANG) : '共享泳装') + '</div></div>' + (girlNames[s.girl] ? '' : '<span class="badge badge-blush">共享</span>') + '<span class="badge badge-sand">' + String(s.sell || '').slice(0, 4) + '</span>' + (isNew(s) ? '<span class="badge badge-blush">新</span>' : '') + '<span class="badge ' + typeChip + '">' + (s.type || '').toUpperCase() + '</span></div>' +
            '<div class="mt-2 grid grid-cols-4 gap-1">' + statTile('P', s.pow, 'attr-pow') + statTile('T', s.tec, 'attr-tec') + statTile('S', s.stm, 'attr-stm') + statTile('A', s.apl, 'attr-apl') + '</div>' +
            (s.skills.length ? '<div class="mt-2 flex flex-wrap gap-1">' + s.skills.slice(0, 2).map((k) => '<span class="badge ' + skillPropClass((skillMap[k] || {}).property) + '">' + skillText(skillMap, k, LANG).name + '</span>').join('') + '</div>' : '') +
            '<button class="fav-a" style="position:absolute;top:8px;right:8px;border:none;background:transparent;cursor:pointer;font-size:16px;color:#e6a04c">' + (isFav('suits', s.id) ? '★' : '☆') + '</button>';
          el.addEventListener('click', () => openSuitModal(s, skillMap, LANG, Object.assign({}, binds, { img: (star.has(s.id) ? (document.documentElement.getAttribute('data-base') || '/') + 'img/bromide/star/' + s.id + '.webp' : (girlImg[s.girl] || '')) })));
          el.querySelector('.fav-a').addEventListener('click', (e) => { e.stopPropagation(); toggleFav('suits', s.id); e.currentTarget.textContent = isFav('suits', s.id) ? '★' : '☆'; });
          list.appendChild(el);
        });
        more.classList.toggle('hidden', shown >= f.length);
      }
      search.addEventListener('input', () => { qtext = search.value.trim().toLowerCase(); shown = 36; render(); });
      girlSel.addEventListener('change', () => { girl = girlSel.value; shown = 36; render(); });
      typeBox.addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; type = b.dataset.type; typeBox.querySelectorAll('button').forEach((x) => { x.className = 'badge cursor-pointer ' + (x === b ? 'badge-pool' : 'bg-white/70 text-ink-soft border border-line'); }); shown = 36; render(); });
      more.addEventListener('click', () => { shown += 36; render(); });
      sSkill.addEventListener('input', () => { skillQ = sSkill.value.trim().toLowerCase(); shown = 36; render(); });
      sPow.addEventListener('input', () => { minPow = sPow.value; shown = 36; render(); });
      sTec.addEventListener('input', () => { minTec = sTec.value; shown = 36; render(); });
      sStm.addEventListener('input', () => { minStm = sStm.value; shown = 36; render(); });
      sApl.addEventListener('input', () => { minApl = sApl.value; shown = 36; render(); });
      sSort.addEventListener('change', () => { sort = sSort.value; shown = 36; render(); });
      sReset.addEventListener('click', () => { sSkill.value = ''; sPow.value = ''; sTec.value = ''; sStm.value = ''; sApl.value = ''; sSort.value = '默认'; sYear.value = '全部'; skillQ = ''; minPow = ''; minTec = ''; minStm = ''; minApl = ''; sort = '默认'; year = '全部'; shown = 36; render(); });
      const yrYears = [...new Set(suits.map((s) => String(s.sell || '').slice(0, 4)).filter((y) => /^\d{4}$/.test(y)))].sort().reverse();
      yrYears.forEach((y) => { const o = document.createElement('option'); o.value = y; o.textContent = y + ' 年'; sYear.appendChild(o); });
      sYear.addEventListener('change', () => { year = sYear.value; shown = 36; render(); });
      render();
      window.addEventListener('langchange', (e) => { window.__LANG = e.detail; render(); });
    })();
  </script>
</Base>