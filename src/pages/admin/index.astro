---
import Base from '../../layouts/Base.astro';
import pending from '../../../admin/pending.json';
import girls from '../../data/doax-girls.json';
import suits from '../../data/doax-ssr.json';
import skills from '../../data/doax-skills.json';
import official from '../../data/official-news.json';
const root = import.meta.env.BASE_URL || '/';

// —— 统计数据整合 ——
const stats = {
  girls: girls.length,
  suits: suits.length,
  skills: skills.length,
  news: (official.history||[]).length,
  pending: pending.length,
  suitType: Object.fromEntries(['pow','tec','stm','apl'].map(t => [t, suits.filter(s => s.type === t).length])),
  skillProp: Object.fromEntries(['pow','tec','stm','apl'].map(pr => [pr, skills.filter(s => s.property === pr).length])),
};
const TYPE_LABEL = { pow: '力量', tec: '技巧', stm: '体力', apl: '魅力' };
---

<Base title="后台管理 · 待上传建档 · DOAXVV 攻略站" desc="流行泳装待上传列表与上传建档。">
  <div class="container-wiki py-10">
    <p class="text-sm font-semibold text-pool-600">后台管理</p>
    <h1 class="mt-1 text-3xl font-black">数据总览</h1>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {[
        ['女孩图鉴', stats.girls],
        ['泳装图鉴', stats.suits],
        ['技能图鉴', stats.skills],
        ['官方公告', stats.news],
        ['待上传建档', stats.pending],
      ].map(([label, n]) => (
        <div class="card-wiki p-4">
          <div class="text-xs font-semibold text-ink-soft">{label}</div>
          <div class="mt-1 text-3xl font-black text-pool-700">{n}</div>
        </div>
      ))}
    </div>
    <div class="mt-3 grid gap-3 md:grid-cols-2">
      <div class="card-wiki p-4">
        <div class="text-xs font-semibold text-ink-soft">泳装类型分布</div>
        <div class="mt-2 space-y-2">
          {Object.entries(stats.suitType).map(([t, n]) => (
            <div class="flex items-center gap-2 text-sm">
              <span class="w-10 shrink-0 text-ink-soft">{TYPE_LABEL[t]}</span>
              <div class="h-2 flex-1 overflow-hidden rounded-full bg-pool-100"><div class="h-full rounded-full bg-gradient-to-r from-pool-400 to-pool-600" style={`width:${stats.suits ? Math.round(n / stats.suits * 100) : 0}%`}></div></div>
              <span class="w-14 shrink-0 text-right tabular-nums text-ink">{n}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="card-wiki p-4">
        <div class="text-xs font-semibold text-ink-soft">技能属性分布</div>
        <div class="mt-2 space-y-2">
          {Object.entries(stats.skillProp).map(([pr, n]) => (
            <div class="flex items-center gap-2 text-sm">
              <span class="w-10 shrink-0 text-ink-soft">{TYPE_LABEL[pr]}</span>
              <div class="h-2 flex-1 overflow-hidden rounded-full bg-pool-100"><div class="h-full rounded-full bg-gradient-to-r from-blush-300 to-blush-500" style={`width:${stats.skills ? Math.round(n / stats.skills * 100) : 0}%`}></div></div>
              <span class="w-14 shrink-0 text-right tabular-nums text-ink">{n}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
    <p class="mt-3 text-sm font-semibold text-pool-600">待上传建档</p>
    <div class="mt-2 rounded-xl border border-sand-300 bg-sand-200/40 p-4 text-sm text-ink-soft">
      静态站无后端：本页为<b>本地管理</b>。扫描候选来自公告（<code>admin/pending.json</code>）；确认后写入浏览器 `localStorage`，并通过「导出/合并」进入 <code>src/data/trend-suits.json</code>（构建后并入泳装图鉴）。上传建档：选图 → 自动扫描数据 → 确认表单 → 建档移出。
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <input id="upfile" type="file" accept="image/*" class="file:rounded-full file:border-pool-300 file:bg-pool-50 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-pool-700 text-sm" />
      <span id="upHint" class="text-xs text-ink-soft">选择图片后自动扫描建档</span>
    </div>

    <h2 class="sec-h">待上传列表（{pending.length}）</h2>
    <div id="pending" class="grid gap-4 md:grid-cols-2"></div>
    <h2 class="sec-h">已确认（本月会话）</h2>
    <div id="confirmed" class="grid gap-4 md:grid-cols-2"></div>
    <div class="mt-6 flex flex-wrap gap-3 text-sm">
      <button id="export" class="btn-primary">导出已确认 → trend-suits.json</button>
      <button id="clear" class="rounded-full border border-line bg-white px-5 py-2.5 text-sm font-semibold text-ink-soft">清空已确认</button>
    </div>
  </div>

  <div id="pendingData" hidden>{JSON.stringify(pending)}</div>
  <div id="rootPath" hidden>{root}</div>
  <script>
    const pending = JSON.parse(document.getElementById('pendingData').textContent);
    const rootPath = document.getElementById('rootPath').textContent || '/';
    const pbox = document.getElementById('pending');
    const cbox = document.getElementById('confirmed');
    const KEY = 'trend_confirmed';
    const load = () => JSON.parse(localStorage.getItem(KEY) || '[]');
    const save = (a) => localStorage.setItem(KEY, JSON.stringify(a));
    let confirmed = load();
    const norm = (s) => (s || '').replace(/[（(].*?[)）]/g, '').trim().toLowerCase();

    function card(obj, isConfirmed) {
      const el = document.createElement('div');
      el.className = 'card-wiki p-4';
      el.innerHTML =
        '<div class="flex items-start gap-3">' + (obj.image ? '<img src="' + rootPath + obj.image + '" alt="' + obj.name + '" class="h-16 w-16 rounded-lg object-cover" onerror="this.style.display=\'none\'" />' : '<div class="grid h-16 w-16 place-items-center rounded-lg bg-pool-50 text-pool-300">图</div>') +
        '<div class="min-w-0 flex-1"><div class="truncate font-extrabold text-pool-700">' + obj.name + '</div><div class="truncate text-xs text-ink-soft">' + (obj.source ? (obj.source.title || obj.source.url || '') : '') + '</div><div class="mt-1 text-xs text-ink-soft">' + (obj.date || '') + '</div></div></div>' +
        (isConfirmed ? '<p class="mt-2 text-xs text-ink-soft">详情：' + (Object.keys(obj.details || {}).length ? '已补' : '空置(待补)') + '</p>' : '<div class="mt-3 flex gap-2"><button class="btn-primary text-xs" data-confirm>' + obj.id + '</button>') +
        (isConfirmed ? '' : '</div>');
      el.querySelector('[data-confirm]')?.addEventListener('click', () => confirmOne(obj));
      return el;
    }

    function render() {
      pbox.innerHTML = ''; cbox.innerHTML = '';
      const pids = new Set(confirmed.map((x) => x.id));
      pending.filter((p) => !pids.has(p.id)).forEach((p) => pbox.appendChild(card(p, false)));
      confirmed.forEach((c) => cbox.appendChild(card(c, true)));
    }

    function confirmOne(obj) {
      if (confirm('确认建档：' + obj.name + ' ?')) {
        if (!confirmed.some((c) => c.id === obj.id)) confirmed.push({ ...obj, details: {}, status: 'confirmed' });
        save(confirmed); render();
      }
    }

    async function scanFile(file) {
      const name = file.name.replace(/\.(png|jpe?g|webp)$/i, '').trim();
      const suits = await fetch(rootPath + 'data/doax-ssr.json').then((r) => r.json());
      const hit = suits.find((s) => norm(s.name) === norm(name) || (s.name || '').toLowerCase().includes(name.toLowerCase()) || name.toLowerCase().includes(norm(s.name)));
      const base = { id: 'up-' + Date.now(), name, jp: name, image: '', source: { title: '后台上传', url: '' }, date: new Date().toISOString().slice(0, 10), details: {} };
      if (hit) base.details = { pow: hit.pow, tec: hit.tec, stm: hit.stm, apl: hit.apl };
      const nm = prompt('确认泳装名（可改）：', base.name); if (nm === null) return; base.name = nm.trim() || base.name;
      if (hit) confirm('自动扫描命中图鉴：' + hit.name + '，已填数值。确定？') && (confirmed = confirmed.filter((x) => x.id !== base.id).concat([base]), save(confirmed), render());
      else { if (!confirm('未命中图鉴，按“详情空置”建档？')) return; confirmed = confirmed.filter((x) => x.id !== base.id).concat([base]); save(confirmed); render(); }
    }

    document.getElementById('upfile').addEventListener('change', (e) => { const f = e.target.files[0]; if (f) scanFile(f); });
    document.getElementById('export').addEventListener('click', () => {
      const blob = new Blob([JSON.stringify({ snapshot: new Date().toISOString().slice(0, 10), suits: confirmed }, null, 2)], { type: 'application/json' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'trend-suits-export.json'; a.click();
    });
    document.getElementById('clear').addEventListener('click', () => { if (confirm('清空已确认？')) { confirmed = []; save(confirmed); render(); } });
    render();
  </script>
</Base>
