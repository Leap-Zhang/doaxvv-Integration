---
import Base from '../layouts/Base.astro';
import helpData from '../data/doax-help.json';
const root = import.meta.env.BASE_URL || '/';
const clean = (s) => (s || '').replace(/\uFEFF/g, '').split('\n').map((l) => l.trim()).filter((l) => l && !/ENGLISH|繁體中文|简体中文|日本語|한국어|Customer Support|End User|Privacy Policy|Microsoft|Valve|©|Back to Top|※本网站/.test(l)).join('\n');
const titleOf = (h) => {
  const t = (h.title || '').replace(/\uFEFF/g, '').trim();
  if (t) return t;
  const lines = (h.body || '').split('\n').map((l) => l.trim()).filter(Boolean);
  for (const l of lines) if (/[\u4e00-\u9fff]/.test(l)) return l.replace(/^\s*\d+[.\u3001：:]*\s*/, '').trim();
  return h.slug;
};
---

<Base title="帮助中心 · DOAXVV 攻略站" desc="整理自官方 Game Help 的中文帮助条目。">
  <div class="container-wiki py-10">
    <p class="text-sm font-semibold text-pool-600">帮助中心</p>
    <h1 class="mt-1 text-3xl font-black">帮助中心（中文）</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">整理自官方 <b class="text-ink">Game Help</b> 各主题，已本地化；详细图示见<a href="https://game.doaxvv.com/production/html/information/help_cn.html" target="_blank" rel="noopener" class="font-semibold text-pool-600">官方帮助</a>。</p>

    <div class="mt-6 space-y-3">
      {helpData.map((h) => (
        <details class="card-wiki p-4" open={h.slug === 'home'}>
          <summary class="cursor-pointer text-base font-extrabold text-ink">{titleOf(h)}</summary>
          <div class="mt-2 whitespace-pre-line text-sm leading-relaxed text-ink-soft">{clean(h.body)}</div>
        </details>
      ))}
    </div>
  </div>
</Base>