---
import Base from '../layouts/Base.astro';
import { changelog, snapshot } from '../data/changelog.js';
const stat = [
  ['泳装 SSR', '3191'], ['Steam 泳装', '155'], ['技能', '401'], ['角色', '33'],
  ['等级 / 经验表', '100'], ['月度纪念', '90'], ['活动', '10'], ['潜力 / PP', '19'],
  ['饰品升级素材', '8'], ['亲密度等级', '60']
];
---

<Base title="数据快照与更新日志 · DOAXVV 攻略站" desc="数据来源、快照日期与版本更新记录。">
  <div class="container-wiki py-10">
    <p class="text-sm font-semibold text-pool-600">关于本站</p>
    <h1 class="mt-1 text-3xl font-black">数据快照与更新日志</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">本站为社区向攻略站，数据整理自 <a href="https://doax.cc/" target="_blank" rel="noopener" class="font-semibold text-pool-600">doax.cc</a> 与官方/社区公开资料（已本地化）。数据快照：<b class="text-ink">{snapshot}</b>。</p>

    <h2 class="sec-h">运行配置（官方 Spec）</h2>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="card-wiki p-5">
        <p class="text-xs font-semibold text-pool-600">平台 / 服务</p>
        <dl class="mt-3 space-y-1 text-sm">
          <div class="flex justify-between border-b border-line/60 pb-1"><dt class="text-ink-soft">平台</dt><dd class="font-semibold">Steam® / Johren®</dd></div>
          <div class="flex justify-between border-b border-line/60 pb-1"><dt class="text-ink-soft">分级</dt><dd class="font-semibold">CERO D</dd></div>
          <div class="flex justify-between border-b border-line/60 pb-1"><dt class="text-ink-soft">状态</dt><dd class="font-semibold">服务中</dd></div>
          <div class="flex justify-between border-b border-line/60 pb-1"><dt class="text-ink-soft">付费</dt><dd class="font-semibold">基本免费 / 道具付费</dd></div>
        </dl>
      </div>
      <div class="card-wiki p-5">
        <p class="text-xs font-semibold text-pool-600">画面 / 帧率</p>
        <dl class="mt-3 space-y-1 text-sm">
          <div class="flex justify-between border-b border-line/60 pb-1"><dt class="text-ink-soft">帧率</dt><dd class="font-semibold">30 帧（可切 60 / 30）</dd></div>
          <div class="flex justify-between border-b border-line/60 pb-1"><dt class="text-ink-soft">分辨率</dt><dd class="font-semibold">960×540 / Full HD / 4K</dd></div>
          <div class="flex justify-between border-b border-line/60 pb-1"><dt class="text-ink-soft">引擎特效</dt><dd class="font-semibold">软绵绵引擎 2.0</dd></div>
        </dl>
      </div>
    </div>
    <div class="overflow-auto rounded-2xl border border-line bg-white shadow-sm">
      <table class="tbl w-full">
        <thead><tr><th>配置项</th><th>最低</th><th>推荐 (Full HD)</th><th>推荐 (4K)</th></tr></thead>
        <tbody>
          <tr><td>OS</td><td>Windows 11 64bit</td><td>Windows 11 64bit</td><td>Windows 11 64bit</td></tr>
          <tr><td>CPU</td><td>Core i3-8100</td><td>Core i3-8100</td><td>Core i3-8100</td></tr>
          <tr><td>显卡</td><td>Core i3-8100 内置 (UHD 630)</td><td>60帧：GTX 960 2GB　30帧：RADEON R7 370</td><td>60帧：GTX 1080Ti 11GB　30帧：GTX 1060 6GB</td></tr>
          <tr><td>内存</td><td>8GB 以上</td><td>8GB 以上</td><td>8GB 以上</td></tr>
          <tr><td>硬盘</td><td>20GB 以上</td><td>20GB 以上</td><td>20GB 以上</td></tr>
          <tr><td>DirectX</td><td>11（声卡 9.0c+）</td><td>11</td><td>11</td></tr>
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-ink-soft">来源：<a href="https://game.doaxvv.com/" target="_blank" rel="noopener" class="font-semibold text-pool-600">官方网站 Spec</a>。软绵绵引擎 2.0 支持高质模型、衣服滑落、晒黑、肌肤潮红、高级肌肤/变形效果。</p>

    <h2 class="sec-h">数据模块一览</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {stat.map((s) => (
        <div class="rounded-2xl border border-line bg-white p-4">
          <div class="text-xs text-ink-soft">{s[0]}</div>
          <div class="mt-1 text-2xl font-black text-pool-700">{s[1]}</div>
        </div>
      ))}
    </div>

    <h2 class="sec-h">更新日志</h2>
    <div class="space-y-3">
      {changelog.map((l) => (
        <div class="rounded-2xl border border-line bg-white p-4">
          <div class="flex items-center gap-2"><span class="badge badge-pool">{l[0]}</span><span class="text-xs text-ink-soft">{l[1]}</span></div>
          <p class="mt-1 text-sm text-ink">{l[2]}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 rounded-2xl border border-line bg-white p-6 text-sm text-ink-soft">
      <b class="text-ink">版权与免责</b>：站内为《DEAD OR ALIVE Xtreme Venus Vacation》（光荣特库摩）之攻略与游戏图片，整理为移动学习/资讯向、非商用；数据与攻略以来源站及官方为准，如有疑问以原站为准。
    </div>
  </div>
</Base>